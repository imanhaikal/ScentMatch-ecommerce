# Shopify Storefront API. Local fallback products can power the prototype catalog,
# but Shopify checkout handoff requires live gid://shopify/ProductVariant/... IDs.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_token"
SHOPIFY_STOREFRONT_API_VERSION="2026-04"
SHOPIFY_WEBHOOK_SECRET="your_webhook_secret_if_using_webhooks"

# GA4. Use a real measurement ID in the deployed demo before capturing DebugView.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA_DEBUG_MODE="false"

# Account backend. The default data path is local file-backed demo persistence;
# replace with a production provider/database before multi-instance deployment.
SCENTMATCH_SESSION_SECRET="replace_with_32_plus_characters"
SCENTMATCH_ACCOUNT_DATA_PATH=".scentmatch/account-store.json"
